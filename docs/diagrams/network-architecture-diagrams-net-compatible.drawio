<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="Secure Remote-Access VPN Architecture" id="secure-vpn-architecture">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Secure Remote-Access VPN Architecture&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#16243A;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="850" height="38" as="geometry"/></mxCell><mxCell id="subtitle" value="WireGuard-based remote access to internal corporate resources" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#64748B;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="42" y="60" width="850" height="25" as="geometry"/></mxCell><mxCell id="remote" value="&lt;b&gt;REMOTE USERS&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;(WireGuard Clients)&lt;/font&gt;&lt;br&gt;&lt;br&gt;Windows&lt;br&gt;Linux&lt;br&gt;Android&lt;br&gt;iOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6FF;strokeColor=#2F80ED;strokeWidth=2;fontColor=#16243A;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="245" height="330" as="geometry"/></mxCell><mxCell id="internet" value="&lt;b&gt;INTERNET&lt;/b&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#EEF6FF;strokeColor=#5D7FA3;strokeWidth=2;fontColor=#16243A;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="355" y="235" width="175" height="95" as="geometry"/></mxCell><mxCell id="router" value="&lt;b&gt;ROUTER / FIREWALL&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;VPN traffic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#AAB4C3;strokeWidth=2;fontColor=#16243A;fontSize=15;" vertex="1" parent="1"><mxGeometry x="600" y="235" width="250" height="95" as="geometry"/></mxCell><mxCell id="server" value="&lt;b&gt;WIREGUARD SERVER&lt;/b&gt;&lt;br&gt;Ubuntu Server 24.04 LTS&lt;br&gt;&lt;br&gt;&lt;font color='#64748B'&gt;VPN gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2F2;strokeColor=#D9534F;strokeWidth=2;fontColor=#16243A;fontSize=15;" vertex="1" parent="1"><mxGeometry x="915" y="200" width="310" height="165" as="geometry"/></mxCell><mxCell id="vpn" value="&lt;b&gt;WIREGUARD VPN&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;VPN Network: 10.0.0.0/24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECF9F2;strokeColor=#159B67;strokeWidth=2;fontColor=#16243A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="105" width="300" height="75" as="geometry"/></mxCell><mxCell id="internal" value="&lt;b&gt;INTERNAL NETWORK&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;192.168.1.0/24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6FF;strokeColor=#2F80ED;strokeWidth=2;fontColor=#16243A;fontSize=15;" vertex="1" parent="1"><mxGeometry x="945" y="445" width="250" height="95" as="geometry"/></mxCell><mxCell id="resources" value="&lt;b&gt;CORPORATE RESOURCES&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;Internal services and resources&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF6FF;strokeColor=#2F80ED;strokeWidth=2;fontColor=#16243A;fontSize=15;" vertex="1" parent="1"><mxGeometry x="905" y="605" width="330" height="100" as="geometry"/></mxCell><mxCell id="params" value="&lt;b&gt;NETWORK PARAMETERS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;VPN protocol:&lt;/b&gt; WireGuard&lt;br&gt;&lt;b&gt;VPN network:&lt;/b&gt; 10.0.0.0/24&lt;br&gt;&lt;b&gt;Listening port:&lt;/b&gt; UDP 51820&lt;br&gt;&lt;b&gt;Server OS:&lt;/b&gt; Ubuntu Server 24.04 LTS&lt;br&gt;&lt;b&gt;Internal network:&lt;/b&gt; 192.168.1.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6DCE5;strokeWidth=1;fontColor=#16243A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1290" y="145" width="300" height="270" as="geometry"/></mxCell><mxCell id="flow" value="&lt;b&gt;TRAFFIC FLOW&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Remote clients establish an encrypted WireGuard connection.&lt;br&gt;2. VPN traffic reaches the corporate network through the router/firewall.&lt;br&gt;3. The WireGuard server routes authorized traffic to the internal network.&lt;br&gt;4. Authorized users can access permitted corporate resources." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFD;strokeColor=#D6DCE5;strokeWidth=1;fontColor=#64748B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="530" height="180" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#159B67'&gt;━━▶&lt;/font&gt; Encrypted VPN connection&lt;br&gt;&lt;font color='#2F80ED'&gt;━━▶&lt;/font&gt; Internal network access&lt;br&gt;&lt;font color='#D9534F'&gt;━━▶&lt;/font&gt; VPN traffic / UDP 51820" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6DCE5;strokeWidth=1;fontColor=#16243A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1290" y="455" width="300" height="170" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#159B67;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="remote" target="internet"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#159B67;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="internet" target="router"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="UDP 51820" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D9534F;strokeWidth=3;endArrow=block;endFill=1;fontColor=#D9534F;fontStyle=1;" edge="1" parent="1" source="router" target="server"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F80ED;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="server" target="internal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F80ED;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="internal" target="resources"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#159B67;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="vpn" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
